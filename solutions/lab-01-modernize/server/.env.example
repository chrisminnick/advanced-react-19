# Copy this to `.env` only if the defaults don't fit your machine.
# All settings have working defaults so the chat server boots out of the box.

# socket.io server port. Default: 8081.
SERVER_PORT=8081

# MongoDB host. Default: mongodb://localhost:27017
# (the chat server appends /real-time-chat for the database name)
MONGO_URI=mongodb://localhost:27017

# JWT signing secret for the legacy /api/user routes. The new flow uses the
# social-media/server backend on port 4000; this is here for back-compat only.
ACCESS_TOKEN_SECRET=dev-only-not-for-production
TOKEN_EXPIRATION=24h
