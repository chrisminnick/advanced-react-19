# Copy this file to `.env` and adjust if the defaults don't work for you.

# Port the API listens on. New starters expect 4000.
PORT=4000

# MongoDB connection string. Local default works out of the box once mongod is running.
MONGO_URL=mongodb://localhost:27017/social-network

# JWT signing secret. CHANGE THIS in production. The fallback in code is intentionally obvious.
ACCESS_TOKEN_SECRET=dev-only-not-for-production

# Extra CORS origins (comma-separated). Localhost dev ports (5173, 5174, 3000, 3001) are always allowed.
ALLOWED_ORIGINS=

# Set to `production` to enable Secure cookies and tighter logging.
NODE_ENV=development
